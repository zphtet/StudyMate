# StudyMate environment variables (docs/technical-spec.md §15).
# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Production and preview values live in Vercel (and Supabase secrets), not in files.

# ── Database (Prisma) ─────────────────────────────────────────────────────────────
# Supabase dashboard → Connect. Use a development project locally, never production.
# Prisma CLI (migrate deploy / migrate diff): Session pooler, port 5432.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Prisma Client at runtime: Transaction pooler, port 6543. Server-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Supabase (Auth, Storage, Realtime) ────────────────────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (or the legacy anon key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), Project Settings → API Keys. SERVER-ONLY: never prefix with
# NEXT_PUBLIC_ and never import it from client code. Used for account deletion and e2e fixtures.
SUPABASE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────────────────────
# Used for auth redirects and invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Notifications (feature 006) ───────────────────────────────────────────────────
# Generate once: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@yourdomain
VAPID_SUBJECT=
# Shared secret for cron calls: pg_cron → POST /api/cron/dispatch (spec 006) and Vercel Cron →
# GET /api/cron/purge (spec 002, daily). Set the same value in Vercel. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────────
# Also set in Supabase → Auth → SMTP (password field). Server-only.
RESEND_API_KEY=
